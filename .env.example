# Groq API keys (rotates automatically across available keys on rate limits / errors)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_COOLDOWN_SECONDS=60

# Gemini fallback (used automatically if all Groq keys fail or are rate-limited)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings: auto | gemini | local_hash
# "auto" uses Gemini embeddings when GEMINI_API_KEY is set, otherwise local_hash for offline dev
EMBEDDING_PROVIDER=auto
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Phase 4: Spoken Audio Voice-Note (edge-tts) & Telegram Bot Delivery
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=-6%
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
